+
+        if (is_array($decoded) && isset($decoded['reply']) && is_string($decoded['reply'])) {
+            $suggestions = collect($decoded['suggestions'] ?? [])
+                ->filter(fn ($s) => is_string($s) && trim($s) !== '')
+                ->map(fn ($s) => mb_substr(trim($s), 0, 48))
